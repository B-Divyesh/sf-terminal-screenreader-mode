{
  "name": "terminal-screenreader-mode-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "cargo build --release && vite build --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "test": "cargo test && npm run build && playwright test",
    "package": "cargo package --allow-dirty",
    "test:site": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
